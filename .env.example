# ============================================================
# .env.example — copy เป็น .env แล้วแก้ค่าให้ตรงกับของคุณ
# ============================================================

# PORT ที่ API Server รัน (Nginx จะ proxy มาที่นี่)
PORT=8080

# Path ของ Chrome Profile ที่ login LINE Manager ไว้แล้ว
# (สร้างได้จาก: bash login-line.sh)
CHROME_PROFILE_DIR=/root/.line-chrome-profile

# Discord Webhook สำหรับรับการแจ้งเตือน
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_HERE

# ตรวจสอบสถานะ LINE ทุกกี่วินาที (ค่าเริ่ม 60 = 1 นาที)
CHECK_INTERVAL=60

# สแกนไลน์สำรองทุกกี่วินาที (ค่าเริ่ม 300 = 5 นาที)
BACKUP_SCAN_INTERVAL=300
